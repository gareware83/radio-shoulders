# Kernel options for the comms DSP PL design.
#
# CONFIG_XILINX_DMA is deliberately absent - it's already =y in the
# multi_v7 defconfig, so the AXI DMA driver needs nothing added here.

# UIO, for userspace access to reg_rw_interface's register window
# (the generic-uio node at 0x43c00000).
CONFIG_UIO=y
CONFIG_UIO_PDRV_GENIRQ=y

# FPGA manager, for reloading bitstreams from Linux at runtime without a
# reboot. Not needed for the boot-time path (U-Boot programs the PL from
# the FIT before Linux starts) - this is purely a development convenience.
# No devicetree work required: mainline zynq-7000.dtsi already declares
# both the devcfg node and an fpga-region referencing it.
CONFIG_FPGA=y
CONFIG_FPGA_MGR_ZYNQ_FPGA=y
CONFIG_FPGA_REGION=y
CONFIG_OF_FPGA_REGION=y
