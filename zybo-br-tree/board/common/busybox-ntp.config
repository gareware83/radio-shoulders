# Extra busybox applets, merged over Buildroot's default busybox config.
#
# Neither the Zybo Z7 nor the PYNQ-Z1 has a battery-backed RTC, so the clock
# starts from scratch on every boot (1980, or the kernel's build epoch) and
# every timestamp in every log is meaningless until something sets it.
#
# busybox's ntpd rather than the ntp or chrony packages: it is already being
# built, so this costs a few KB of applet rather than a new package, and the
# only features needed are "step a wildly wrong clock" and "keep it honest".
CONFIG_NTPD=y
CONFIG_FEATURE_NTPD_SERVER=y
CONFIG_FEATURE_NTPD_CONF=y
